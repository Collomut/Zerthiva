# ==========================================
# Zerthiva Environment Configuration
# ==========================================

# Application
PROJECT_NAME="Zerthiva Cloud Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Authentication
SECRET_KEY="zerthiva-super-secret-key-change-in-production-min-32-chars"
DEVICE_PSK="sg-field-device-pre-shared-key-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite fallback for instant zero-dependency testing:
DATABASE_URL="sqlite+aiosqlite:///./zerthiva.db"
# Production TimescaleDB / PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://zerthiva_user:zerthiva_pass@localhost:5432/zerthiva_db"

# SMS Gateway (Africa's Talking / Twilio)
SMS_PROVIDER="mock"  # "mock", "africastalking", "twilio"
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY=""
AFRICASTALKING_SENDER_ID="Zerthiva"

# Twilio (Fallback)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Agronomic Defaults
DEFAULT_IRRIGATION_WATER_EC=0.6
MIN_LEACHING_REQUIREMENT=0.05
MAX_LEACHING_REQUIREMENT=0.45
